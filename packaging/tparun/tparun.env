# TPA.run packaged defaults. Host-specific values belong here; package mode is root:tparun 0640.
TPARUN_PROFILE=self-hosted
TPARUN_LISTEN=127.0.0.1:8082
TPARUN_DATA_DIR=/var/lib/tparun/data
GNUPGHOME=/var/lib/tparun/gnupg
TPA_BIN=tpa
TPARUN_REGISTRATION_ENABLED=false
TPARUN_CAPABILITY_SOURCE=local
TPARUN_BILLING=none
TPARUN_BILLING_PROVIDER=none
TPARUN_DELIVERY_MODE=metrics-only
TPARUN_EGRESS_ENFORCEMENT=none
TPARUN_OPERATOR_RP_ID=tpa.run
TPARUN_OPERATOR_ORIGIN=https://tpa.run
# Server-enforced publication, transient-storage, disk, inode and retention bounds.
TPARUN_PUBLISH_TIMEOUT=10m
TPARUN_UPLOAD_READ_TIMEOUT=15m
TPARUN_MAX_UPLOAD_BYTES=536870912
TPARUN_MAX_STAGING_BYTES=4294967296
TPARUN_MAX_ACCOUNT_STAGING_BYTES=1073741824
TPARUN_MAX_CANDIDATE_INODES=65536
TPARUN_MIN_DISK_FREE_BYTES=104857600
TPARUN_MIN_FREE_INODES=1024
TPARUN_MAX_GENERATIONS=5
