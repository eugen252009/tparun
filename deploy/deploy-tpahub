#!/usr/bin/env bash
# Authoritative TPA Hub deployment hook. Migration is performed by the staged
# candidate while the service is stopped; promotion happens only afterwards.
set -Eeuo pipefail

HOME_DIR=${HOME_DIR:-/home/eugen}
REPO=${REPO:-$HOME_DIR/tpahub}
RELEASES=${RELEASES:-$HOME_DIR/tpahub_releases}
CURRENT=${CURRENT:-$HOME_DIR/tpahub_current}
SERVICE=${SERVICE:-tpahub.service}
LOCK=${LOCK:-$HOME_DIR/tpahub-deploy.lock}
ENV_FILE=${ENV_FILE:-$HOME_DIR/.config/tpahub/tpahub.env}
if [[ -f "$ENV_FILE" ]]; then set -a; source "$ENV_FILE"; set +a; fi
DATA_DIR=${TPAHUB_DATA_DIR:-$HOME_DIR/data/tpahub}
DB=${TPAHUB_DB:-$DATA_DIR/tpahub.db}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:8082/version}
GO=${GO:-$HOME_DIR/.local/go/bin/go}
SQLITE3=${SQLITE3:-sqlite3}
SYSTEMCTL=${SYSTEMCTL:-systemctl}
TPA_SCHEMA=${TPA_SCHEMA:-/home/eugen/bin/tpa schema}
CURL=${CURL:-curl}
PYTHON=${PYTHON:-python3}
HEALTH_ATTEMPTS=${TPAHUB_DEPLOY_HEALTH_ATTEMPTS:-30}
HEALTH_INTERVAL=${TPAHUB_DEPLOY_HEALTH_INTERVAL:-1}

exec 9>"$LOCK"
flock -n 9 || { echo 'Deployment already running; latest push will be deployed by it.'; exit 0; }
commit=$(git --git-dir="$REPO" rev-parse refs/heads/staging)
short=${commit:0:12}
current_commit=''
if [[ -L "$CURRENT" && -f "$CURRENT/.deploy-commit" ]]; then current_commit=$(cat "$CURRENT/.deploy-commit"); fi
if [[ "$current_commit" == "$commit" ]]; then echo "Already deployed $short"; exit 0; fi
mkdir -p "$RELEASES"
release="$RELEASES/$commit"
tmp="$RELEASES/.tmp-$commit-$$"
previous=''
[[ -L "$CURRENT" ]] && previous=$(readlink -f "$CURRENT") || true
backup="${DB}.pre-migrate-${commit}-$(date -u +%Y%m%dT%H%M%SZ).db"
service_stopped=0
candidate_promoted=0
migration_attempted=0
db_restore_required=0
succeeded=0
cleanup(){ rm -rf "$tmp"; }
trap cleanup EXIT

restore_database(){
  local restored="${DB}.rollback.$$"
  rm -f "${DB}-wal" "${DB}-shm" "$restored" || return 1
  cp -- "$backup" "$restored"
  chmod --reference="$backup" "$restored"
  mv -f -- "$restored" "$DB"
  rm -f "${DB}-wal" "${DB}-shm" || return 1
  [[ "$($SQLITE3 "$DB" 'PRAGMA integrity_check;')" == ok ]]
  [[ -z "$($SQLITE3 "$DB" 'PRAGMA foreign_key_check;')" ]]
  [[ "$($SQLITE3 "$DB" 'SELECT version FROM tpahub_schema WHERE singleton=1;')" == "$schema_before" ]]
}

health_payload_valid(){
  "$PYTHON" - "$1" "$2" <<'PY'
import json, sys
from datetime import datetime
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        value = json.load(f)
    assert value.get("service") == "tpahub"
    assert value.get("version") == sys.argv[2]
    started = value.get("started_at")
    assert started
    datetime.fromisoformat(started.replace("Z", "+00:00"))
except Exception:
    raise SystemExit(1)
PY
}

rollback_health_ok(){
  local body="$RELEASES/.rollback-health-$$.json" code
  for _ in {1..10}; do
    code=$($CURL -sS -o "$body" -w '%{http_code}' --max-time 3 "$HEALTH_URL" || true)
    if [[ "$code" == 200 ]] && health_payload_valid "$body" "$previous_version"; then rm -f "$body"; return 0; fi
    sleep 0.1
  done
  rm -f "$body"
  return 1
}

deployment_failed(){
  local reason=${1:-unknown failure}
  local rollback_failed=0
  trap - ERR
  echo "DEPLOYMENT FAILED: $reason" >&2
  if (( service_stopped && candidate_promoted )); then
    if ! $SYSTEMCTL --user stop "$SERVICE"; then rollback_failed=1; fi
  fi
  if (( service_stopped && candidate_promoted && !db_restore_required && !rollback_failed )); then
    if [[ "$($release/tpahub digest --db "$DB")" != "$db_before_digest" ]]; then db_restore_required=1; fi
  fi
  if (( service_stopped && db_restore_required && !rollback_failed )); then
    if restore_database; then
      echo "database restored from $backup (schema $schema_before)" >&2
    else
      echo 'database rollback failed' >&2
      rollback_failed=1
    fi
  fi
  if (( candidate_promoted && !rollback_failed )); then
    if [[ -n "$previous" && -d "$previous" ]]; then
      if ! ln -s "$previous" "$HOME_DIR/.tpahub_current.rollback.$$" || ! mv -Tf "$HOME_DIR/.tpahub_current.rollback.$$" "$CURRENT"; then
        rollback_failed=1
      fi
    else
      rollback_failed=1
    fi
  fi
  if (( service_stopped )); then
    if (( !rollback_failed )) && ! $SYSTEMCTL --user start "$SERVICE"; then rollback_failed=1; fi
    if (( !rollback_failed )) && ! $SYSTEMCTL --user is-active --quiet "$SERVICE"; then rollback_failed=1; fi
    if (( !rollback_failed )); then
      previous_version="$expected_version"
      if ! rollback_health_ok; then rollback_failed=1; fi
    fi
  fi
  if (( rollback_failed )); then
    echo 'MANUAL INTERVENTION REQUIRED: deployment rollback failed' >&2
  fi
  exit 1
}
on_error(){
  local status=$?
  deployment_failed "command failed (exit $status)"
}
trap on_error ERR

if [[ ! -d "$release" ]]; then
  mkdir "$tmp"
  git --git-dir="$REPO" archive "$commit" | tar -x -C "$tmp"
  (cd "$tmp" && "$GO" build -o "$tmp/tpahub" ./cmd/tpahub)
  test -x "$tmp/tpahub"
  $TPA_SCHEMA >/dev/null
  mv "$tmp" "$release"
fi

# sqlite3 .backup is safe for WAL-mode databases and is taken before quiescing.
$SQLITE3 "$DB" ".backup '$backup'"
printf 'backup=%s sha256=' "$backup"; sha256sum "$backup" | cut -d' ' -f1
[[ "$($SQLITE3 "$backup" 'PRAGMA integrity_check;')" == ok ]]
[[ -z "$($SQLITE3 "$backup" 'PRAGMA foreign_key_check;')" ]]
schema_before="$($SQLITE3 "$backup" 'SELECT version FROM tpahub_schema WHERE singleton=1;')"
[[ "$schema_before" =~ ^[1-9][0-9]*$ ]]
expected_schema="$($release/tpahub schema)"
[[ "$expected_schema" =~ ^[1-9][0-9]*$ ]]
expected_version="$($release/tpahub version)"
[[ -n "$expected_version" ]]
db_before_digest="$($release/tpahub digest --db "$backup")"
printf 'schema_before=%s expected_candidate_schema=%s db_before_digest=%s\n' "$schema_before" "$expected_schema" "$db_before_digest"

if ! $SYSTEMCTL --user stop "$SERVICE"; then
  echo 'Failed to stop service; attempting to leave old service running.' >&2
  $SYSTEMCTL --user start "$SERVICE" || echo 'DEPLOYMENT FAILED — ROLLBACK FAILED' >&2
  exit 1
fi
service_stopped=1

migration_attempted=1
db_restore_required=1
if ! "$release/tpahub" migrate; then deployment_failed 'candidate migration failed'; fi
if [[ "${TPAHUB_DEPLOY_TEST_FAILURE:-}" == after-migration-before-promotion ]]; then deployment_failed 'test failure after migration before promotion'; fi
schema_after="$($SQLITE3 "$DB" 'SELECT version FROM tpahub_schema WHERE singleton=1;')"
printf 'schema_after=%s\n' "$schema_after"
if ! [[ "$schema_after" == "$expected_schema" ]]; then deployment_failed 'post-migration schema version mismatch'; fi
if ! [[ "$($SQLITE3 "$DB" 'PRAGMA integrity_check;')" == ok ]]; then deployment_failed 'post-migration integrity check failed'; fi
if ! [[ -z "$($SQLITE3 "$DB" 'PRAGMA foreign_key_check;')" ]]; then deployment_failed 'post-migration foreign-key check failed'; fi
db_after_digest="$($release/tpahub digest --db "$DB")"
printf 'db_after_digest=%s\n' "$db_after_digest"
if [[ "$db_after_digest" == "$db_before_digest" ]]; then db_restore_required=0; fi

if ! ln -s "$release" "$HOME_DIR/.tpahub_current.new.$$" || ! mv -Tf "$HOME_DIR/.tpahub_current.new.$$" "$CURRENT"; then
  deployment_failed 'candidate promotion failed'
fi
candidate_promoted=1
if [[ "${TPAHUB_DEPLOY_TEST_FAILURE:-}" == after-promotion-before-start ]]; then deployment_failed 'test failure after promotion before start'; fi

health_body="$RELEASES/.health-$commit-$$.json"
cleanup_health(){ rm -f "$health_body"; }
trap 'cleanup_health; cleanup' EXIT
if ! $SYSTEMCTL --user start "$SERVICE"; then deployment_failed 'candidate service start failed'; fi
health_ok=0
for ((i=1; i<=HEALTH_ATTEMPTS; i++)); do
  if ! $SYSTEMCTL --user is-active --quiet "$SERVICE"; then
    sleep "$HEALTH_INTERVAL" || deployment_failed 'health wait failed'
    continue
  fi
  code=$($CURL -sS -o "$health_body" -w '%{http_code}' --max-time 3 "$HEALTH_URL" || true)
  if [[ "$code" == 200 ]] && "$PYTHON" - "$health_body" "$expected_version" <<'PY'
import json, sys
from datetime import datetime
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        value = json.load(f)
    assert value.get("service") == "tpahub"
    assert value.get("version") == sys.argv[2]
    started = value.get("started_at")
    assert started
    datetime.fromisoformat(started.replace("Z", "+00:00"))
except Exception:
    raise SystemExit(1)
PY
  then
    health_ok=1
    break
  fi
  sleep "$HEALTH_INTERVAL" || deployment_failed 'health wait failed'
done
if (( ! health_ok )); then deployment_failed 'candidate health check failed'; fi

if ! printf '%s\n' "$commit" > "$release/.deploy-commit.new.$$" || ! mv -f "$release/.deploy-commit.new.$$" "$release/.deploy-commit"; then
  deployment_failed 'deployment marker update failed'
fi
trap - ERR
rm -f "$health_body"
echo "Deployed $short"
find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -name '[0-9a-f]*' -printf '%T@ %p\n' | sort -rn | tail -n +3 | cut -d' ' -f2- | xargs -r rm -rf
exit 0
