#!/usr/bin/env bash
# Authoritative single-node TPA.run deployment hook.
# The historical tpahub service/path names are retained for compatibility.
set -Eeuo pipefail

HOME_DIR=${HOME_DIR:-/home/eugen}
PROD_ROOT=${PROD_ROOT:-$HOME_DIR/vserver-tpahub-qualification}
BINARY=${BINARY:-$PROD_ROOT/bin/tparun}
DATA_DIR=${DATA_DIR:-$PROD_ROOT/data}
DB=${DB:-$DATA_DIR/tpahub.db}
GNUPGHOME_DIR=${GNUPGHOME_DIR:-$PROD_ROOT/gnupg}
RELEASE_ROOT=${RELEASE_ROOT:-$PROD_ROOT/releases}
REPO=${REPO:-$HOME_DIR/tpahub}
SERVICE=${SERVICE:-tparun.service}
LOCK=${LOCK:-$HOME_DIR/tpahub-deploy.lock}
ENV_FILE=${ENV_FILE:-$HOME_DIR/.config/tparun/tparun.env}
GO=${GO:-$HOME_DIR/.local/go/bin/go}
SQLITE3=${SQLITE3:-sqlite3}
CURL=${CURL:-curl}
PYTHON=${PYTHON:-python3}
SYSTEMCTL=${SYSTEMCTL:-systemctl}
PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-https://tpa.run}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:8082/version}
HEALTH_ORIGIN=${HEALTH_ORIGIN:-${HEALTH_URL%/version}}
[[ -n "$HEALTH_ORIGIN" ]] || HEALTH_ORIGIN=http://127.0.0.1:8082
HEALTH_ATTEMPTS=${TPARUN_DEPLOY_HEALTH_ATTEMPTS:-30}
HEALTH_INTERVAL=${TPARUN_DEPLOY_HEALTH_INTERVAL:-1}
CURRENT_SCHEMA=11
ALLOW_SCHEMA_MIGRATION=${TPARUN_ALLOW_SCHEMA_MIGRATION:-false}

[[ -x "$GO" ]] || GO=$(command -v go)
[[ -n "$GO" ]] || { echo 'TPA.run deployment requires Go' >&2; exit 1; }
if [[ -f "$ENV_FILE" ]]; then set -a; source "$ENV_FILE"; set +a; fi

[[ "$PROD_ROOT" == "$HOME_DIR/vserver-tpahub-qualification" ]] || { echo 'unexpected production root' >&2; exit 1; }
[[ "$DATA_DIR" == "$PROD_ROOT/data" && "$DB" == "$DATA_DIR/tpahub.db" ]] || { echo 'unexpected production data path' >&2; exit 1; }
[[ "$BINARY" == "$PROD_ROOT/bin/tparun" ]] || { echo 'unexpected production binary path' >&2; exit 1; }
[[ "$GNUPGHOME_DIR" == "$PROD_ROOT/gnupg" ]] || { echo 'unexpected production signing path' >&2; exit 1; }

exec 9>"$LOCK"
flock -n 9 || { echo 'Deployment already running; latest push will be deployed by it.'; exit 0; }

commit=$(git --git-dir="$REPO" rev-parse --verify refs/heads/staging^{commit})
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo 'staging is not an exact commit' >&2; exit 1; }
short=${commit:0:12}
mkdir -p "$RELEASE_ROOT"
release="$RELEASE_ROOT/$commit"
stage="$RELEASE_ROOT/.tmp-$commit-$$"
rollback="${TPARUN_ROLLBACK_ROOT:-$HOME_DIR}/tparun-public-rollback-$(date -u +%Y%m%dT%H%M%SZ)-$$"
previous=''
[[ -L "$PROD_ROOT/current" ]] && previous=$(readlink -f "$PROD_ROOT/current") || true
health_body="$RELEASE_ROOT/.health-$commit-$$.json"
service_stopped=0
candidate_promoted=0
rollback_ready=0
migration_ran=0
migration_state=NO
rollback_required=0

cleanup() { rm -rf "$stage" "$health_body"; }
trap cleanup EXIT

json_value() {
  "$PYTHON" - "$1" "$2" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    value = json.load(f)
item = value.get(sys.argv[2])
if item is None:
    raise SystemExit(1)
print(item)
PY
}

validate_version() {
  local file=$1 expected_revision=$2 expected_schema=$3 expected_version=$4
  "$PYTHON" - "$file" "$expected_revision" "$expected_schema" "$expected_version" <<'PY'
import json, sys
from datetime import datetime
with open(sys.argv[1], encoding='utf-8') as f:
    v = json.load(f)
assert v.get('service') == 'tparun'
assert v.get('revision') == sys.argv[2]
assert v.get('schema') == sys.argv[3]
assert v.get('version') == sys.argv[4]
assert datetime.fromisoformat(v['started_at'].replace('Z', '+00:00'))
PY
}

validate_ready() {
  local file=$1 expected_schema=$2
  "$PYTHON" - "$file" "$expected_schema" <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8') as f:
    v = json.load(f)
assert v == {'ready': True, 'schema': int(sys.argv[2])}
PY
}

health_ok() {
  local expected_revision=$1 expected_schema=$2 expected_version=$3
  local version_file="$RELEASE_ROOT/.health-check-$$.json"
  local ready_file="$RELEASE_ROOT/.ready-check-$$.json"
  local version_code ready_code
  for _ in $(seq 1 "$HEALTH_ATTEMPTS"); do
    version_code=$($CURL -sS -o "$version_file" -w '%{http_code}' --max-time 3 "$HEALTH_ORIGIN/version" || true)
    ready_code=$($CURL -sS -o "$ready_file" -w '%{http_code}' --max-time 3 "$HEALTH_ORIGIN/ready" || true)
    if [[ "$version_code" == 200 && "$ready_code" == 200 ]] && \
       validate_version "$version_file" "$expected_revision" "$expected_schema" "$expected_version" && \
       validate_ready "$ready_file" "$expected_schema"; then
      rm -f "$version_file" "$ready_file"
      return 0
    fi
    sleep "$HEALTH_INTERVAL"
  done
  rm -f "$version_file" "$ready_file"
  return 1
}

verify_public_artifacts() {
  local body code repo_url pkg_path
  for endpoint in / /pricing /docs /how-to /nano /login /register; do
    code=$($CURL -sS -o /dev/null -w '%{http_code}' --max-time 10 "$PUBLIC_ORIGIN$endpoint" || true)
    [[ "$code" == 200 ]] || { echo "public endpoint failed: $endpoint ($code)" >&2; return 1; }
  done
  for endpoint in /account /ops; do
    code=$($CURL -sS -o /dev/null -w '%{http_code}' --max-time 10 "$PUBLIC_ORIGIN$endpoint" || true)
    [[ "$code" == 303 ]] || { echo "public endpoint failed: $endpoint ($code)" >&2; return 1; }
  done
  code=$($CURL -sS -o /dev/null -w '%{http_code}' --max-time 10 "$PUBLIC_ORIGIN/tparun.sources" || true)
  [[ "$code" == 200 ]] || return 1
  code=$($CURL -sS -o /dev/null -w '%{http_code}' --max-time 10 "$PUBLIC_ORIGIN/tparun-bootstrap.deb" || true)
  [[ "$code" == "${TPARUN_BOOTSTRAP_PACKAGE_STATUS:-404}" ]] || return 1
  code=$($CURL -sS -o /dev/null -w '%{http_code}' --max-time 10 "$PUBLIC_ORIGIN/r/tparun/bootstrap" || true)
  [[ "$code" == "${TPARUN_BOOTSTRAP_REPOSITORY_STATUS:-404}" ]] || return 1

  body="$RELEASE_ROOT/.public-repositories-$$.json"
  $CURL -fsS --max-time 10 "$PUBLIC_ORIGIN/v1/public/repositories" -o "$body"
  repo_url=$("$PYTHON" - "$body" "$PUBLIC_ORIGIN" <<'PY'
import json, sys
repos=json.load(open(sys.argv[1], encoding='utf-8'))
for r in repos:
    if r.get('name') != 'tparun-bootstrap' and r.get('username') and r.get('name'):
        print(sys.argv[2].rstrip('/') + '/r/' + r['username'] + '/' + r['name'])
        break
else:
    raise SystemExit('no public repository available')
PY
)
  $CURL -fsS --max-time 10 "$repo_url/dists/stable/InRelease" -o "$RELEASE_ROOT/.public-inrelease-$$"
  $CURL -fsS --max-time 10 "$repo_url/dists/stable/main/binary-amd64/Packages" -o "$RELEASE_ROOT/.public-packages-$$"
  pkg_path=$(awk '/^Filename:/{print $2; exit}' "$RELEASE_ROOT/.public-packages-$$")
  [[ -n "$pkg_path" ]] || { echo 'public package metadata contains no artifact' >&2; return 1; }
  $CURL -fsS --max-time 10 "$repo_url/$pkg_path" -o "$RELEASE_ROOT/.public-package-$$"
  rm -f "$body" "$RELEASE_ROOT/.public-inrelease-$$" "$RELEASE_ROOT/.public-packages-$$" "$RELEASE_ROOT/.public-package-$$"
}

restore_state() {
  local restored_data="$PROD_ROOT/.data-rollback-$$"
  local restored_gpg="$PROD_ROOT/.gnupg-rollback-$$"
  [[ -d "$rollback/data" && -d "$rollback/gnupg" ]] || return 1
  rm -rf "$restored_data" "$restored_gpg"
  cp -a "$rollback/data" "$restored_data"
  cp -a "$rollback/gnupg" "$restored_gpg"
  rm -rf "$DATA_DIR" "$GNUPGHOME_DIR"
  mv "$restored_data" "$DATA_DIR"
  mv "$restored_gpg" "$GNUPGHOME_DIR"
  [[ "$($SQLITE3 "$DB" 'PRAGMA integrity_check;')" == ok ]]
  [[ -z "$($SQLITE3 "$DB" 'PRAGMA foreign_key_check;')" ]]
  [[ "$($SQLITE3 "$DB" 'SELECT version FROM tpahub_schema WHERE singleton=1;')" == "$schema_before" ]]
}

deployment_failed() {
  local reason=${1:-unknown failure} rollback_failed=0
  trap - ERR
  echo "TPA.run deployment failed: $reason" >&2
  if (( service_stopped )); then
    $SYSTEMCTL --user stop "$SERVICE" || rollback_failed=1
  fi
  if (( service_stopped && rollback_ready && !rollback_failed )); then
    restore_state || rollback_failed=1
  fi
  if (( candidate_promoted && !rollback_failed )); then
    install -m 0755 "$rollback/tparun" "$BINARY" || rollback_failed=1
    [[ "$(sha256sum "$BINARY" | awk '{print $1}')" == "$(awk '{print $1}' "$rollback/tparun.sha256")" ]] || rollback_failed=1
    if [[ -n "$previous" && -d "$previous" ]]; then
      ln -s "$previous" "$PROD_ROOT/current.rollback.$$" && mv -Tf "$PROD_ROOT/current.rollback.$$" "$PROD_ROOT/current" || rollback_failed=1
    fi
  fi
  if (( service_stopped && !rollback_failed )); then
    $SYSTEMCTL --user start "$SERVICE" || rollback_failed=1
    $SYSTEMCTL --user is-active --quiet "$SERVICE" || rollback_failed=1
    health_ok "$previous_revision" "$schema_before" "$previous_version" || rollback_failed=1
    verify_public_artifacts || rollback_failed=1
  fi
  if (( rollback_failed )); then
    echo "MANUAL INTERVENTION REQUIRED: rollback failed; rollback state: $rollback" >&2
  else
    echo "TPA.run rollback restored revision=$previous_revision schema=$schema_before" >&2
  fi
  exit 1
}
on_error() { deployment_failed "command failed (exit $?)"; }
trap on_error ERR

if [[ ! -d "$release" ]]; then
  mkdir -p "$stage"
  git --git-dir="$REPO" archive "$commit" | tar -x -C "$stage"
  (cd "$stage" && "$GO" build -trimpath -ldflags="-s -w -X github.com/eugen252009/tpahub/internal/version.BuildRevision=$commit" -o "$stage/tparun" ./cmd/tparun)
  chmod 0755 "$stage/tparun"
  candidate_diag="$stage/.candidate-diagnostics.json"
  TPARUN_DATA_DIR="$stage/.diagnostics" "$stage/tparun" diagnostics > "$candidate_diag"
  candidate_revision=$(json_value "$candidate_diag" revision)
  [[ "$candidate_revision" == "$commit" ]] || { echo 'candidate embedded revision mismatch' >&2; exit 1; }
  candidate_version=$(json_value "$candidate_diag" version)
  candidate_schema=$("$stage/tparun" schema)
  [[ "$candidate_schema" =~ ^[1-9][0-9]*$ && "$candidate_schema" -ge "$CURRENT_SCHEMA" ]] || { echo "unsupported candidate schema: $candidate_schema" >&2; exit 1; }
  printf '%s\n' "$commit" > "$stage/.source-revision"
  sha256sum "$stage/tparun" > "$stage/tparun.sha256"
  mv "$stage" "$release"
else
  [[ -x "$release/tparun" && -f "$release/.source-revision" && "$(cat "$release/.source-revision")" == "$commit" ]] || { echo 'existing release does not match exact source revision' >&2; exit 1; }
  candidate_diag="$release/.candidate-diagnostics.json"
  TPARUN_DATA_DIR="$release/.diagnostics" "$release/tparun" diagnostics > "$candidate_diag"
  candidate_revision=$(json_value "$candidate_diag" revision)
  candidate_version=$(json_value "$candidate_diag" version)
  candidate_schema=$("$release/tparun" schema)
fi
candidate_sha=$(sha256sum "$release/tparun" | awk '{print $1}')
printf 'TPA.run candidate revision=%s schema=%s version=%s binary_sha256=%s\n' "$commit" "$candidate_schema" "$candidate_version" "$candidate_sha"

[[ -f "$DB" && -d "$GNUPGHOME_DIR" && -x "$BINARY" ]] || { echo 'production state is incomplete' >&2; exit 1; }
unit=$($SYSTEMCTL --user cat "$SERVICE")
grep -Fq "ExecStart=$BINARY serve" <<<"$unit" || { echo 'service ExecStart is not the live tparun binary' >&2; exit 1; }
grep -Fq "WorkingDirectory=$PROD_ROOT" <<<"$unit" || { echo 'service WorkingDirectory is not the live production root' >&2; exit 1; }
grep -Fq "TPARUN_DATA_DIR=$DATA_DIR" <<<"$unit" || { echo 'service data directory is not the live production data directory' >&2; exit 1; }
grep -Fq "TPARUN_RELEASE_DIR=$RELEASE_ROOT" <<<"$unit" || { echo 'service release directory is not the live production release directory' >&2; exit 1; }
current_body="$RELEASE_ROOT/.current-version-$$.json"
$CURL -fsS --max-time 3 "$HEALTH_ORIGIN/version" -o "$current_body"
previous_revision=$(json_value "$current_body" revision)
previous_version=$(json_value "$current_body" version)
previous_schema=$(json_value "$current_body" schema)
previous_service=$(json_value "$current_body" service)
[[ "$previous_service" == tparun ]] || { echo "unexpected running service: $previous_service" >&2; exit 1; }
[[ "$previous_schema" == "$CURRENT_SCHEMA" ]] || { echo "production schema is not current: $previous_schema" >&2; exit 1; }
[[ "$previous_revision" =~ ^[0-9a-f]{40}$ ]] || { echo 'current deployed revision is invalid' >&2; exit 1; }
$SQLITE3 "$DB" 'PRAGMA integrity_check;' | grep -qx ok
[[ -z "$($SQLITE3 "$DB" 'PRAGMA foreign_key_check;')" ]]
schema_before="$($SQLITE3 "$DB" 'SELECT version FROM tpahub_schema WHERE singleton=1;')"
[[ "$schema_before" == "$CURRENT_SCHEMA" ]] || { echo "database schema is not current: $schema_before" >&2; exit 1; }
[[ "$candidate_schema" -ge "$schema_before" ]] || { echo 'candidate would downgrade the database schema' >&2; exit 1; }
if [[ "$candidate_schema" != "$schema_before" && "$ALLOW_SCHEMA_MIGRATION" != true ]]; then
  echo "candidate schema transition $schema_before -> $candidate_schema requires TPARUN_ALLOW_SCHEMA_MIGRATION=true" >&2
  exit 1
fi
rm -f "$current_body"

mkdir -p "$rollback" && chmod 0700 "$rollback"
cp -p "$BINARY" "$rollback/tparun"
sha256sum "$BINARY" > "$rollback/tparun.sha256"
$SYSTEMCTL --user cat "$SERVICE" > "$rollback/tparun.service"
[[ ! -e "$ENV_FILE" ]] || { [[ -r "$ENV_FILE" ]] && cp -p "$ENV_FILE" "$rollback/tparun.env"; }
printf '%s\n' "$DB" > "$rollback/database-path"
printf '%s\n' "$schema_before" > "$rollback/database-schema"
printf '%s\n' "$previous_revision" > "$rollback/deployed-revision"
printf '%s\n' "$candidate_sha" > "$rollback/candidate-sha256"
$SQLITE3 "$DB" ".backup '$rollback/tpahub.db'"
[[ "$($SQLITE3 "$rollback/tpahub.db" 'PRAGMA integrity_check;')" == ok ]]
[[ -z "$($SQLITE3 "$rollback/tpahub.db" 'PRAGMA foreign_key_check;')" ]]
sha256sum "$rollback/tpahub.db" > "$rollback/tpahub.db.sha256"

if ! $SYSTEMCTL --user stop "$SERVICE"; then
  $SYSTEMCTL --user start "$SERVICE" || true
  exit 1
fi
service_stopped=1
cp -a "$DATA_DIR" "$rollback/data"
cp -a "$GNUPGHOME_DIR" "$rollback/gnupg"
[[ -r "$rollback/data/tpahub.db" && -r "$rollback/gnupg" ]] || { echo 'rollback state is unreadable' >&2; exit 1; }
rollback_ready=1

if [[ "$candidate_schema" != "$schema_before" ]]; then
  migration_ran=1
  migration_state=YES
  rollback_required=1
  TPARUN_DATA_DIR="$DATA_DIR" "$release/tparun" migrate
fi
schema_after="$($SQLITE3 "$DB" 'SELECT version FROM tpahub_schema WHERE singleton=1;')"
[[ "$schema_after" == "$candidate_schema" ]] || deployment_failed 'post-migration schema mismatch'
$SQLITE3 "$DB" 'PRAGMA integrity_check;' | grep -qx ok || deployment_failed 'post-migration integrity failure'
[[ -z "$($SQLITE3 "$DB" 'PRAGMA foreign_key_check;')" ]] || deployment_failed 'post-migration foreign-key failure'
[[ "$migration_ran" == 1 || "$schema_after" == "$schema_before" ]] || deployment_failed 'unexpected schema transition'

candidate_binary="$BINARY.new.$$"
install -m 0755 "$release/tparun" "$candidate_binary"
mv -f "$candidate_binary" "$BINARY"
[[ "$(sha256sum "$BINARY" | awk '{print $1}')" == "$candidate_sha" ]] || deployment_failed 'deployed binary digest mismatch'
candidate_promoted=1
$SYSTEMCTL --user start "$SERVICE" || deployment_failed 'candidate service start failed'
$SYSTEMCTL --user is-active --quiet "$SERVICE" || deployment_failed 'candidate service is not active'
health_ok "$commit" "$candidate_schema" "$candidate_version" || deployment_failed 'candidate health validation failed'
verify_public_artifacts || deployment_failed 'public artifact validation failed'
printf '%s\n' "$commit" > "$release/.deploy-commit"

printf 'TPA.run deployed revision=%s schema_before=%s schema_after=%s migration=%s binary_sha256=%s rollback=%s\n' \
  "$commit" "$schema_before" "$schema_after" "$migration_state" "$candidate_sha" "$rollback"
find "$RELEASE_ROOT" -mindepth 1 -maxdepth 1 -type d -name '[0-9a-f]*' -printf '%T@ %p\n' | sort -rn | tail -n +3 | cut -d' ' -f2- | xargs -r rm -rf
trap - EXIT
cleanup
exit 0
