#!/usr/bin/env bash
# Rollback-safe deployment for the live Schema 7 TPA Hub service.
# The production root is intentionally explicit: the older /home/eugen/data
# lineage is legacy and must never be selected by this script.
set -Eeuo pipefail

HOME_DIR=${HOME_DIR:-/home/eugen}
PROD_ROOT=${PROD_ROOT:-$HOME_DIR/vserver-tpahub-qualification}
BINARY=${BINARY:-$PROD_ROOT/bin/tpahub}
DATA_DIR=${DATA_DIR:-$PROD_ROOT/data}
DB=${DB:-$DATA_DIR/tpahub.db}
GNUPGHOME_DIR=${GNUPGHOME_DIR:-$PROD_ROOT/gnupg}
RELEASE_ROOT=${RELEASE_ROOT:-$PROD_ROOT/releases}
REPO=${REPO:-$HOME_DIR/tpahub}
SERVICE=${SERVICE:-tpahub.service}
LOCK=${LOCK:-$HOME_DIR/tpahub-deploy.lock}
GO=${GO:-$HOME_DIR/.local/go/bin/go}
[[ -x "$GO" ]] || GO=$(command -v go)
SQLITE3=${SQLITE3:-sqlite3}
CURL=${CURL:-curl}
PYTHON=${PYTHON:-python3}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1:8082/version}
PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-https://tpa.run}
PUBLIC_READY_URL="$PUBLIC_ORIGIN/ready"
PUBLIC_INSTALL_URL="$PUBLIC_ORIGIN/install.sh"

fail(){ echo "DEPLOYMENT FAILED: $*" >&2; exit 1; }

[[ "$PROD_ROOT" == "$HOME_DIR/vserver-tpahub-qualification" ]] || fail "unexpected production root: $PROD_ROOT"
[[ "$DATA_DIR" == "$PROD_ROOT/data" ]] || fail "unexpected data path: $DATA_DIR"
[[ "$DB" == "$PROD_ROOT/data/tpahub.db" ]] || fail "unexpected database path: $DB"
[[ "$BINARY" == "$PROD_ROOT/bin/tpahub" ]] || fail "unexpected binary path: $BINARY"
[[ "$GNUPGHOME_DIR" == "$PROD_ROOT/gnupg" ]] || fail "unexpected GPG path: $GNUPGHOME_DIR"
[[ "$DB" != "$HOME_DIR/data/tpahub/tpahub.db" ]] || fail "legacy Schema 3 database selected"

exec 9>"$LOCK"
flock -n 9 || { echo 'Deployment already running; latest push will be deployed by it.'; exit 0; }

commit=$(git --git-dir="$REPO" rev-parse refs/heads/staging)
short=${commit:0:12}

if [[ "${DRY_RUN:-0}" == 1 ]]; then
  printf 'DRY RUN\nsource_commit=%s\nproduction_root=%s\nbinary=%s\ndatabase=%s\nschema_required=8\ngnupg=%s\nrelease_root=%s\nservice=%s\nhealth=%s\npublic_release=%s\n' \
    "$commit" "$PROD_ROOT" "$BINARY" "$DB" "$GNUPGHOME_DIR" "$RELEASE_ROOT" "$SERVICE" "$HEALTH_URL" "$PUBLIC_ORIGIN"
  exit 0
fi

[[ -f "$DB" ]] || fail "current production database missing: $DB"
[[ -d "$GNUPGHOME_DIR" ]] || fail "current production GPG directory missing: $GNUPGHOME_DIR"
[[ -x "$BINARY" ]] || fail "current production binary missing: $BINARY"
[[ "$(sqlite3 "$DB" 'PRAGMA integrity_check;')" == ok ]] || fail 'production database integrity check failed'
schema=$($SQLITE3 "$DB" 'SELECT version FROM tpahub_schema WHERE singleton=1;')
[[ "$schema" == 5 || "$schema" == 7 || "$schema" == 8 ]] || fail "refusing deployment against unsupported database schema: $schema"

unit=$(systemctl --user cat "$SERVICE")
grep -Fq "ExecStart=$BINARY serve" <<<"$unit" || fail "service ExecStart is not the live production binary"
grep -Fq "WorkingDirectory=$PROD_ROOT" <<<"$unit" || fail "service WorkingDirectory is not the live production root"
grep -Fq "TPAHUB_DATA_DIR=$DATA_DIR" <<<"$unit" || fail "service data directory is not the live production data directory"
grep -Fq "TPAHUB_RELEASE_DIR=$RELEASE_ROOT" <<<"$unit" || fail "service release directory is not the live production release directory"
grep -Fq "TPAHUB_OPERATOR_RP_ID=tpa.run" <<<"$unit" || fail 'operator RP ID is not tpa.run'
grep -Fq "TPAHUB_OPERATOR_ORIGIN=https://tpa.run" <<<"$unit" || fail 'operator origin is not https://tpa.run'

package_file=$(git --git-dir="$REPO" show "$commit:install.sh" | grep -oE 'tpahub-release_[0-9][^/" ]*_all\.deb' | head -1)
package_sha=$(git --git-dir="$REPO" show "$commit:install.sh" | sed -n 's/.*:-\([0-9a-f]\{64\}\)}$/\1/p' | head -1)
dest_package="$RELEASE_ROOT/$package_file"
current_body=$(mktemp)
if $CURL -fsS --max-time 3 "$HEALTH_URL" >"$current_body" 2>/dev/null && "$PYTHON" - "$current_body" "$commit" <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8') as f:
    value = json.load(f)
assert value.get('revision') == sys.argv[2]
assert value.get('schema') == '8'
PY
then
  if [[ -f "$dest_package" ]] && [[ "$(sha256sum "$dest_package" | awk '{print $1}')" == "$package_sha" ]] && $CURL -fsSL --max-time 5 "$PUBLIC_ORIGIN/$package_file" -o "$current_body.public" && [[ "$(sha256sum "$current_body.public" | awk '{print $1}')" == "$package_sha" ]]; then
    rm -f "$current_body" "$current_body.public"
    echo "Already deployed $short"
    exit 0
  fi
fi
rm -f "$current_body" "$current_body.public"

rollback="$HOME_DIR/tpahub-public-rollback-$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -m 700 "$rollback"
cp -p "$BINARY" "$rollback/tpahub"
sha256sum "$BINARY" >"$rollback/tpahub.sha256"
systemctl --user cat "$SERVICE" >"$rollback/tpahub.service"
if [[ -f "$HOME_DIR/.config/tpahub/tpahub.env" ]]; then cp -p "$HOME_DIR/.config/tpahub/tpahub.env" "$rollback/tpahub.env"; fi
printf '%s\n' "$DB" >"$rollback/database-path"
printf '%s\n' "$schema" >"$rollback/database-schema"

stage="$RELEASE_ROOT/.tmp-$commit-$$"
mkdir -p "$stage"
chmod 700 "$stage"
cleanup(){ rm -rf "$stage"; }
trap cleanup EXIT

archive="$stage/source"
mkdir "$archive"
git --git-dir="$REPO" archive "$commit" | tar -x -C "$archive"
built_package_file=$(grep -oE 'tpahub-release_[0-9][^/" ]*_all\.deb' "$archive/install.sh" | head -1)
built_package_sha=$(sed -n 's/.*:-\([0-9a-f]\{64\}\)}$/\1/p' "$archive/install.sh" | head -1)
[[ "$built_package_file" == "$package_file" && "$built_package_sha" == "$package_sha" ]] || fail 'installer release metadata changed during archive extraction'
[[ -n "$package_file" && -n "$package_sha" ]] || fail 'could not derive release package and checksum from installer'

candidate="$stage/tpahub"
(cd "$archive" && "$GO" build -trimpath -ldflags="-s -w -X github.com/eugen252009/tpahub/internal/version.BuildRevision=$commit" -o "$candidate" ./cmd/tpahub)
chmod 0755 "$candidate"
[[ "$("$candidate" version)" == 0.1.1 ]] || fail 'candidate application version mismatch'
[[ "$("$candidate" schema)" == 8 ]] || fail 'candidate schema mismatch'

package="$stage/$package_file"
(cd "$archive" && SOURCE_DATE_EPOCH=0 packaging/tpahub-release/build.sh "$package")
[[ "$(dpkg-deb -f "$package" Package)" == tpahub-release ]] || fail 'release package name mismatch'
package_version=${package_file#tpahub-release_}
package_version=${package_version%_all.deb}
[[ "$(dpkg-deb -f "$package" Version)" == "$package_version" ]] || fail 'release package version mismatch'
[[ "$(dpkg-deb -f "$package" Architecture)" == all ]] || fail 'release package architecture mismatch'
package_extract="$stage/package-root"
dpkg-deb -x "$package" "$package_extract" >/dev/null
grep -Fq 'URIs: https://tpa.run/' "$package_extract/etc/apt/sources.list.d/tpahub.sources" || fail 'release package origin mismatch'
grep -Fq 'Signed-By: /usr/share/keyrings/tpahub-archive-keyring.gpg' "$package_extract/etc/apt/sources.list.d/tpahub.sources" || fail 'release package trust scope mismatch'
actual_package_sha=$(sha256sum "$package" | awk '{print $1}')
[[ "$actual_package_sha" == "$package_sha" ]] || fail "installer/package checksum mismatch: installer=$package_sha built=$actual_package_sha"

mkdir -p "$RELEASE_ROOT"
chmod 0755 "$RELEASE_ROOT"
old_package="$stage/old-package"
old_package_exists=0
if [[ -f "$dest_package" ]]; then cp -p "$dest_package" "$old_package"; old_package_exists=1; fi
database_migrated=0
database_backup="$rollback/tpahub.db"

rollback_deploy(){
  if (( database_migrated )); then install -m 0600 "$database_backup" "$DB"; fi
  set +e
  systemctl --user stop "$SERVICE" >/dev/null 2>&1 || true
  install -m 0755 "$rollback/tpahub" "$BINARY"
  if (( old_package_exists )); then install -m 0644 "$old_package" "$dest_package"; else rm -f "$dest_package"; fi
  systemctl --user start "$SERVICE" >/dev/null 2>&1 || true
  echo "Rolled back binary; rollback material: $rollback" >&2
  exit 1
}

if [[ "$schema" == 5 || "$schema" == 7 ]]; then
  systemctl --user stop "$SERVICE" || rollback_deploy
  cp -p "$DB" "$database_backup"
  if ! TPAHUB_DATA_DIR="$DATA_DIR" "$candidate" migrate; then rollback_deploy; fi
  [[ "$($SQLITE3 "$DB" 'SELECT version FROM tpahub_schema WHERE singleton=1;')" == 8 ]] || rollback_deploy
  database_migrated=1
fi
candidate_binary="$BINARY.new.$$"
install -m 0755 "$candidate" "$candidate_binary"
mv -f "$candidate_binary" "$BINARY"
if [[ "$schema" == 5 || "$schema" == 7 ]]; then
  if ! systemctl --user start "$SERVICE"; then rollback_deploy; fi
else
  if ! systemctl --user restart "$SERVICE"; then rollback_deploy; fi
fi

health_body="$stage/health.json"
for _ in $(seq 1 30); do
  if $CURL -fsS --max-time 3 "$HEALTH_URL" >"$health_body"; then
    if "$PYTHON" - "$health_body" "$commit" <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8') as f:
    value = json.load(f)
assert value.get('service') == 'tpahub'
assert value.get('version') == '0.1.1'
assert value.get('schema') == '8'
assert value.get('revision') == sys.argv[2]
PY
    then break; fi
  fi
  sleep 1
done
if [[ ! -s "$health_body" ]] || ! "$PYTHON" - "$health_body" "$commit" <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8') as f:
    value = json.load(f)
assert value.get('revision') == sys.argv[2]
assert value.get('schema') == '8'
PY
then rollback_deploy; fi

install -m 0644 "$package" "$dest_package.new.$$"
mv -f "$dest_package.new.$$" "$dest_package"
public_package="$stage/public.deb"
if ! $CURL -fsSL "$PUBLIC_ORIGIN/$package_file" -o "$public_package"; then rollback_deploy; fi
[[ "$(sha256sum "$public_package" | awk '{print $1}')" == "$actual_package_sha" ]] || rollback_deploy
public_install="$stage/public-install.sh"
$CURL -fsSL "$PUBLIC_INSTALL_URL" -o "$public_install" || rollback_deploy
grep -Fq "$package_file" "$public_install" || rollback_deploy
grep -Fq "$actual_package_sha" "$public_install" || rollback_deploy
$CURL -fsS "$PUBLIC_READY_URL" >/dev/null || rollback_deploy

printf 'Deployed %s\n' "$short"
printf 'production_root=%s\nrollback=%s\napplication_sha256=' "$PROD_ROOT" "$rollback"
sha256sum "$BINARY" | awk '{print $1}'
printf 'release_package=%s\nrelease_package_sha256=%s\n' "$package_file" "$actual_package_sha"
exit 0
