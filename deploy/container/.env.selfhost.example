# Copy to .env on the NAS and replace every placeholder.
# Immutable internal-registry deployment reference. Do not replace with latest.
TPAHUB_IMAGE=192.168.188.2:9006/tpahub-server@sha256:e0490566039f65f3779db24277bf98c4ba995bce7fea1acfb025b89c0f3a5dfc
TPAHUB_CONFIG_DIR=/srv/tpahub/config
TPAHUB_DATA_DIR=/srv/tpahub/data
# Bind only to the NAS/reverse-proxy interface. TLS terminates at the NAS proxy.
TPAHUB_BIND=127.0.0.1:18080
TPAHUB_UID=10001
TPAHUB_GID=10001
TPAHUB_OPERATOR_RP_ID=packages.home.example
TPAHUB_EXTERNAL_ORIGIN=https://packages.home.example
