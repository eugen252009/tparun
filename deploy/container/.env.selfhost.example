# Copy to .env on the NAS and replace every placeholder.
# Immutable internal-registry deployment reference. Do not replace with latest.
TPARUN_IMAGE=192.168.188.2:9006/tpahub-server@sha256:5143d77d87d3aca81fa46d4af95100bc11e6bf410e936025e2ba6fceaff149ad
TPARUN_CONFIG_DIR=/srv/tpahub/config
TPARUN_DATA_DIR=/srv/tpahub/data
# Bind only to the NAS/reverse-proxy interface. TLS terminates at the NAS proxy.
TPARUN_BIND=127.0.0.1:18080
TPARUN_UID=10001
TPARUN_GID=10001
TPARUN_OPERATOR_RP_ID=packages.home.example
TPARUN_EXTERNAL_ORIGIN=https://packages.home.example
